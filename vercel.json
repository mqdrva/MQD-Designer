{
  "routes": [
    {
      "src": "/(?:index\\.html)?",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      },
      "continue": true
    },
    {
      "src": "/",
      "dest": "/custom-apparel.html"
    },
    {
      "src": "/.well-known/openai-apps-challenge",
      "dest": "/api/openai-apps-challenge"
    },
    {
      "handle": "filesystem"
    }
  ]
}
