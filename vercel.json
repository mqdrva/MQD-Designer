{
  "routes": [
    {
      "src": "/teams/?",
      "status": 307,
      "headers": {
        "Location": "/team-setup.html",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/print-shops/?",
      "status": 307,
      "headers": {
        "Location": "/print-shop-setup.html",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/[lL][nN][oO]/?",
      "status": 307,
      "headers": {
        "Location": "/teams/luvnoone/3d",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/games(?:/.*)?",
      "status": 404,
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/(?:index\\.html)?",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      },
      "continue": true
    },
    {
      "src": "/",
      "dest": "/custom-apparel.html"
    },
    {
      "src": "/.well-known/openai-apps-challenge",
      "dest": "/api/openai-apps-challenge"
    },
    {
      "handle": "filesystem"
    }
  ],
  "rewrites": [
    {
      "source": "/print-shops",
      "destination": "/print-shops.html"
    },
    {
      "source": "/shops/:shop/3d",
      "destination": "/shop-3d.html"
    },
    {
      "source": "/shops/:shop",
      "destination": "/shop-2d.html"
    },
    {
      "source": "/teams",
      "destination": "/teams.html"
    },
    {
      "source": "/teams/:team/3d",
      "destination": "/team-3d.html"
    },
    {
      "source": "/teams/:team",
      "destination": "/team-2d.html"
    }
  ],
  "buildCommand": "npm run build:mappings",
  "outputDirectory": ".",
  "git": {
    "deploymentEnabled": {
      "codex/shirt-games-private-build": false
    }
  }
}
